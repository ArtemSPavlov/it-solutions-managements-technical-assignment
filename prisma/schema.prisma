generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          String        @id
  name        String
  description String
  links       ProfileLink[]
  skills      Skill[]
  experience  Experience[]
  projects    Project[]
}

model ProfileLink {
  id        String  @id @default(cuid())
  label     String
  url       String
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, label])
}

model Skill {
  id        String  @id @default(cuid())
  name      String
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
}

model Experience {
  id           String    @id @default(cuid())
  company      String
  position     String
  startedAt    DateTime
  endedAt      DateTime?
  achievements String[]
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Project {
  id        String  @id @default(cuid())
  name      String
  url       String
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
}
